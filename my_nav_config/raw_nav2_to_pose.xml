<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="15" name="NavigateRecovery">
      
      <PipelineSequence name="NavigateWithReplanning">
        
        <RateController hz="0.3">
          <RecoveryNode number_of_retries="8" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        
        <RecoveryNode number_of_retries="4" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <Fallback name="GlobalRecoveryFallback">
        <GoalUpdated/>
        <Sequence name="GlobalRecoverySequence">
          <ClearEntireCostmap name="ClearLocalCostmap-subnode" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-subnode" service_name="global_costmap/clear_entirely_global_costmap"/>
          <BackUp backup_dist="0.25" backup_speed="0.20" name="GlobalBackup"/>
          <Wait wait_duration="1.0" name="GlobalWait"/>
        </Sequence>
      </Fallback>

    </RecoveryNode>
  </BehaviorTree>
</root>