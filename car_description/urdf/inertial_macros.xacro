<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ============================================================
       常用惯量计算宏。均假设为均匀密度的规则几何体。
       ============================================================ -->

  <!-- 长方体惯量：xyz为原点(可偏移)，size为长宽高（沿x,y,z） -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
               izz="${(1/12) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- 圆柱体惯量，旋转轴沿 Z 轴（例如雷达、支柱、竖直安装件） -->
  <xacro:macro name="inertial_cylinder_z" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
               izz="${(1/2) * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!-- 圆柱体惯量，旋转轴沿 Y 轴（例如左右滚动的车轮） -->
  <xacro:macro name="inertial_cylinder_y" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${(1/2) * mass * radius * radius}" iyz="0.0"
               izz="${(1/12) * mass * (3*radius*radius + length*length)}"/>
    </inertial>
  </xacro:macro>

  <!-- 圆柱体惯量，旋转轴沿 X 轴（例如朝前的摄像头镜头筒） -->
  <xacro:macro name="inertial_cylinder_x" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/2) * mass * radius * radius}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
               izz="${(1/12) * mass * (3*radius*radius + length*length)}"/>
    </inertial>
  </xacro:macro>

  <!-- 球体惯量（备用，暂未使用） -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(2/5) * mass * radius * radius}" ixy="0.0" ixz="0.0"
               iyy="${(2/5) * mass * radius * radius}" iyz="0.0"
               izz="${(2/5) * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

</robot>
